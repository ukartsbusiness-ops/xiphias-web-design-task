/* site-init.js ?" extracted from _Layout.cshtml inline scripts.
   Loaded deferred after jQuery/Bootstrap/Owl. Behavior preserved verbatim. */

// Global (called via inline onclick="xkTogglePlans()" from the .xk-plans
// pricing grid, e.g. safetykiosk.cshtml, foodorderingsoftware.cshtml).
// Toggles the "Show full comparison" / "Show less" state: .is-collapsed on
// the grid hides .xk-plan-more rows and shows the fade (see kiosk.css),
// .is-open on the button swaps its label and flips the chevron.
function xkTogglePlans(gridId, btnId) {
  var grid = document.getElementById(gridId || 'xkPlansGrid');
  var btn = document.getElementById(btnId || 'xkPlansToggle');
  if (!grid || !btn) return;
  grid.classList.toggle('is-collapsed');
  btn.classList.toggle('is-open');
}

        let pendingVideoUrl = null;

        $(document).ready(function () {

            /* ===============================
               Owl Carousel Init
            =============================== */
            var owl = $(".testimonials .owl-carousel").owlCarousel({
                loop: true,
                margin: 22,
                nav: false,
                dots: true,
                autoplay: true,
                autoplayTimeout: 4000,
                center: false,
                stagePadding: 0,
                smartSpeed: 450,
                responsive: {
                    0: { items: 1 },
                    768: { items: 2 },
                    1024: { items: 3 }
                }
            });

            function highlightCenter() {
                $('.testimonials .owl-item').removeClass('active-highlight');
                var activeItems = $('.testimonials .owl-item.active');

                if (activeItems.length) {
                    var middleIndex = Math.floor(activeItems.length / 2);
                    $(activeItems[middleIndex]).addClass('active-highlight');
                }
            }

            owl.on('initialized.owl.carousel translated.owl.carousel', highlightCenter);
            highlightCenter();

            /* Case Studies carousel */
            var csOwl = $('.xk-cs-carousel').owlCarousel({
                loop: true,
                margin: 24,
                nav: false,
                dots: false,
                autoplay: true,
                autoplayTimeout: 3200,
                autoplayHoverPause: true,
                smartSpeed: 500,
                stagePadding: 0,
                autoWidth: false,
                responsive: {
                    0:    { items: 1 },
                    576:  { items: 2 },
                    768:  { items: 3 },
                    1200: { items: 3 }
                }
            });

            function highlightCsCenter() {
                $('.xk-cs-carousel .owl-item').removeClass('active-highlight');
                var activeItems = $('.xk-cs-carousel .owl-item.active');
                if (activeItems.length) {
                    var mid = Math.floor(activeItems.length / 2);
                    $(activeItems[mid]).addClass('active-highlight');
                }
            }
            csOwl.on('initialized.owl.carousel translated.owl.carousel', highlightCsCenter);
            highlightCsCenter();

            /* ===============================
               Close modal on outside click
            =============================== */
            $('#videoModal').on('click', function (e) {
                if (e.target === this) {
                    closeVideoModal();
                }
            });

        });


        /* ======================================================
           NEW FLOW: Open Enquiry First +' Then Show Video
        ====================================================== */

        function openEnquiryBeforeVideo(videoUrl) {

            // If already filled once, show video directly
            if (sessionStorage.getItem("enquiryDone") === "true") {
                showVideo(videoUrl);
                return;
            }

            // Store URL temporarily
            pendingVideoUrl = videoUrl;

            // Trigger your existing Enquire Now button
            $('.static-enquire-btn').first().trigger('click');
        }


        /* Call this AFTER successful enquiry form submit */
        function showVideoAfterEnquiry() {

            sessionStorage.setItem("enquiryDone", "true");

            if (!pendingVideoUrl) return;

            showVideo(pendingVideoUrl);
            pendingVideoUrl = null;
        }


        /* ======================================================
           Video Modal Functions
        ====================================================== */

        function showVideo(videoUrl) {
            document.getElementById('videoFrame').src = videoUrl;
            document.getElementById('videoModal').classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function closeVideoModal() {
            document.getElementById('videoModal').classList.remove('active');
            document.getElementById('videoFrame').src = '';
            document.body.style.overflow = 'auto';
        }


                        document.addEventListener('DOMContentLoaded', function() {
          const tabButtons = document.querySelectorAll('#tec-solutions-tabs .nav-link');
          const megamenu = document.querySelector('#tec-solutions-menu-item .megamenu');

          if (!megamenu || !tabButtons.length) return;

          tabButtons.forEach(button => {
            // Change tab on hover
            button.addEventListener('mouseenter', function() {
              const tab = new bootstrap.Tab(this);
              tab.show();

              // Bootstrap's Tab component walks up with `.closest('.nav-item, .list-group-item')`
              // to find this button's "outer wrapper" and tags it role="presentation". These
              // sidebar tab buttons have no .nav-item wrapper of their own, so closest() keeps
              // climbing and wrongly matches the ancestor megamenu <li id="tec-solutions-menu-item"
              // class="nav-item ...">, stripping its listitem role and breaking the navbar <ul>'s
              // list structure. Undo it every time a tab is shown.
              const tecMenuItem = document.getElementById('tec-solutions-menu-item');
              if (tecMenuItem && tecMenuItem.getAttribute('role') === 'presentation') {
                tecMenuItem.removeAttribute('role');
              }

              // Adjust megamenu width based on active tab
              if (this.id === 'technology-tab') {
                megamenu.style.width = '95%';
                megamenu.style.maxWidth = '1400px';
              } else if (this.id === 'smartnotification-tab') {
                megamenu.style.width = '95%';
                megamenu.style.maxWidth = '1200px';
              } else {
                // Solution or default
                megamenu.style.width = '95%';
                megamenu.style.maxWidth = '1200px';
              }
            });
          });

          // Also handle Bootstrap tab events as fallback
          const technologyTab = document.getElementById('technology-tab');
          const solutionTab = document.getElementById('solution-tab');
          const smartNotificationTab = document.getElementById('smartnotification-tab');

          if (technologyTab) {
            technologyTab.addEventListener('shown.bs.tab', function() {
              megamenu.style.width = '95%';
              megamenu.style.maxWidth = '1400px';
            });
          }

          if (solutionTab) {
            solutionTab.addEventListener('shown.bs.tab', function() {
              megamenu.style.width = '95%';
              megamenu.style.maxWidth = '1200px';
            });
          }

          if (smartNotificationTab) {
            smartNotificationTab.addEventListener('shown.bs.tab', function() {
              megamenu.style.width = '95%';
              megamenu.style.maxWidth = '1200px';
            });
          }
        });



                // Initialize Owl Carousel and equalize item heights
        document.addEventListener('DOMContentLoaded', function () {
          if (!window.jQuery) return;
          var $ = jQuery;

          // ==========================
          // Kiosk carousel
          // ==========================
          var $carousel = $('.kiosk-slide2');
          if ($carousel.length) {
            // Accessibility labels for kiosk carousel
            // Bound BEFORE owlCarousel() init: Owl fires 'initialized.owl.carousel'
            // synchronously from inside the init call below, so a handler attached
            // after that call misses the first firing and dots stay unlabeled until
            // a later refresh/resize - which is what an audit run on first page load sees.
            function labelKioskCarousel() {
              var $this = $carousel;
              $this.find('.owl-prev')
                .attr('aria-label', 'Previous kiosk slide')
                .attr('role', 'button');
              $this.find('.owl-next')
                .attr('aria-label', 'Next kiosk slide')
                .attr('role', 'button');
              $this.find('.owl-dot').each(function (index) {
                $(this)
                  .attr('aria-label', 'Go to kiosk slide ' + (index + 1))
                  .attr('role', 'button');
              });
            }
            $carousel.on('initialized.owl.carousel refreshed.owl.carousel changed.owl.carousel', labelKioskCarousel);

            $carousel.owlCarousel({
              loop: true,
              margin: 20,
              nav: true,
              navText: ['<i class="fa fa-chevron-left"></i>', '<i class="fa fa-chevron-right"></i>'],
              dots: true,
              autoplay: true,
              autoplayTimeout: 3000,
              autoplayHoverPause: true,
              autoplaySpeed: 600,
              smartSpeed: 600,
              slideBy: 1,
              responsive: {
                0: { items: 1 },
                576: { items: 2 },
                768: { items: 2 },
                992: { items: 3 }
              }
            });

            // Fallback in case the init event still fired before dots existed
            labelKioskCarousel();

            // Equalize heights of item containers
            function equalizePortfolioItems() {
              var $items = $carousel.find('.owl-item .item .owl-bg');
              if (!$items.length) return;
              $items.css('height', '');
              var max = 0;
              $items.each(function () {
                var h = $(this).outerHeight();
                if (h > max) max = h;
              });
              if (max > 0) {
                $items.css('height', max + 'px');
              }
            }

            // Call when images are loaded (handles cached images too)
            var $imgs = $carousel.find('img');
            var total = $imgs.length;
            var loaded = 0;
            if (total === 0) {
              setTimeout(equalizePortfolioItems, 50);
            } else {
              $imgs.each(function () {
                if (this.complete) {
                  loaded++;
                } else {
                  $(this).on('load error', function () {
                    loaded++;
                    if (loaded === total) setTimeout(equalizePortfolioItems, 50);
                  });
                }
              });
              setTimeout(equalizePortfolioItems, 200);
            }

            // Recalculate on carousel events and window resize
            $carousel.on('initialized.owl.carousel refreshed.owl.carousel resized.owl.carousel changed.owl.carousel', function () {
              setTimeout(equalizePortfolioItems, 50);
            });

            $(window).on('resize', function () {
              setTimeout(equalizePortfolioItems, 100);
            });
          }

          // ==========================
          // Brand carousel (clients)
          // ==========================
          var $brand = $('.brand-active');
          if ($brand.length) {
            $brand.owlCarousel({
              loop: true,
              margin: 30,
              nav: false,
              dots: false,
              autoplay: true,
              autoplayTimeout: 2500,
              autoplayHoverPause: true,
              smartSpeed: 600,
              responsive: {
                0: { items: 2, margin: 10 },
                600: { items: 3, margin: 10 },
                992: { items: 4, margin: 20 },
                1200: { items: 5, margin: 30 }
              }
            });
          }

          // ==========================
          // Awards carousel
          // ==========================
          var $awardsCarousel = $('.awards-active');
          if ($awardsCarousel.length) {
            // Accessibility labels bound BEFORE init - see kiosk carousel comment above
            // for why binding after owlCarousel() misses the first labeling pass.
            function labelAwardsCarousel() {
              var $this = $awardsCarousel;
              $this.find('.owl-prev')
                .attr('aria-label', 'Previous awards slide')
                .attr('role', 'button');
              $this.find('.owl-next')
                .attr('aria-label', 'Next awards slide')
                .attr('role', 'button');
              $this.find('.owl-dot').each(function (index) {
                $(this)
                  .attr('aria-label', 'Go to awards slide ' + (index + 1))
                  .attr('role', 'button');
              });
            }
            $awardsCarousel.on('initialized.owl.carousel refreshed.owl.carousel changed.owl.carousel', labelAwardsCarousel);

            $awardsCarousel.owlCarousel({
              loop: true,
              margin: 20,
              nav: true,
              navText: ['<i class="fa fa-chevron-left"></i>', '<i class="fa fa-chevron-right"></i>'],
              dots: true,
              autoplay: true,
              autoplayTimeout: 4000,
              autoplayHoverPause: true,
              smartSpeed: 600,
              responsive: {
                0: { items: 1 },
                576: { items: 2 },
                768: { items: 2 },
                992: { items: 3 },
                1200: { items: 4 }
              }
            });

            labelAwardsCarousel();
          }

          // ==========================
          // Products and Services Carousel
          // ==========================
          var $productsCarousel = $('.product-carousel-active');
          if ($productsCarousel.length) {
            // Accessibility labels bound BEFORE init - see kiosk carousel comment above
            // for why binding after owlCarousel() misses the first labeling pass.
            function labelProductsCarousel() {
              var $this = $productsCarousel;
              $this.find('.owl-prev')
                .attr('aria-label', 'Previous product slide')
                .attr('role', 'button');
              $this.find('.owl-next')
                .attr('aria-label', 'Next product slide')
                .attr('role', 'button');
              $this.find('.owl-dot').each(function (index) {
                $(this)
                  .attr('aria-label', 'Go to product slide ' + (index + 1))
                  .attr('role', 'button');
              });
            }
            $productsCarousel.on('initialized.owl.carousel refreshed.owl.carousel changed.owl.carousel', labelProductsCarousel);

            $productsCarousel.owlCarousel({
              loop: true,
              margin: 10, // Reduced from 20 to 10
              nav: true,
              navText: ['<i class="fa fa-chevron-left"></i>', '<i class="fa fa-chevron-right"></i>'],
              dots: true,
              autoplay: true,
              autoplayTimeout: 4000,
              autoplayHoverPause: true,
              smartSpeed: 600,
              responsive: {
                0: { items: 1, margin: 5 },   // Reduced from 10 to 5
                576: { items: 2, margin: 8 }, // Reduced from 15 to 8
                768: { items: 2, margin: 10 },// Reduced from 20 to 10
                992: { items: 3, margin: 10 },// Reduced from 20 to 10
                1200:{ items: 3, margin: 15 } // Reduced from 30 to 15
              }
            });

            labelProductsCarousel();
          }

          // ==========================
          // Food ordering "why" section carousel
          // (Views/Solution/foodorderingsoftware.cshtml only —
          // no-ops elsewhere since the selector won't match.)
          // ==========================
          var $foWhyCarousel = $('.xk-fo-why-carousel');
          if ($foWhyCarousel.length) {
            $foWhyCarousel.owlCarousel({
              loop: true,
              margin: 20,
              nav: false,
              dots: false,
              slideBy: 1,
              autoplay: true,
              autoplayTimeout: 3500,
              autoplayHoverPause: true,
              smartSpeed: 600,
              responsive: {
                0: { items: 1 },
                576: { items: 2 },
                992: { items: 3 }
              }
            });

            var $foWhyWrap = $foWhyCarousel.closest('.xk-fo-why-carousel-wrap');
            $foWhyWrap.find('.xk-fo-why-prev').on('click', function () {
              $foWhyCarousel.trigger('prev.owl.carousel');
            });
            $foWhyWrap.find('.xk-fo-why-next').on('click', function () {
              $foWhyCarousel.trigger('next.owl.carousel');
            });
          }

          // ==========================
          // "How it works" tab row — click to switch active state.
          // (Views/Solution/foodorderingsoftware.cshtml only —
          // no-ops elsewhere since the selector won't match. The
          // "Get a Quote" pill is a real link, not a tab, so it's
          // excluded via :not().)
          // ==========================
          $('.xk-fo-hiw-tabs').on('click', '.xk-fo-hiw-tab:not(.xk-fo-hiw-tab--cta)', function () {
            var $tab = $(this);
            var target = $tab.data('tab');

            $tab.addClass('active').siblings('.xk-fo-hiw-tab').removeClass('active');

            if (target) {
              $('.xk-fo-hiw-panel[data-panel="' + target + '"]').addClass('active')
                .siblings('.xk-fo-hiw-panel').removeClass('active');
            }
          });

          // ==========================
          // Counter Animation Script
          // ==========================
          function animateCounter(counter) {
            var target = parseInt(counter.getAttribute('data-target'));
            var duration = 2000; // 2 seconds
            var increment = target / (duration / 16); // 60fps
            var current = 0;

            function updateCounter() {
              current += increment;
              if (current < target) {
                counter.textContent = Math.floor(current);
                requestAnimationFrame(updateCounter);
              } else {
                counter.textContent = target;
              }
            }
            updateCounter();
          }

          var counters = document.querySelectorAll('.counter');

          if ('IntersectionObserver' in window) {
            var observer = new IntersectionObserver(function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  var counter = entry.target;
                  animateCounter(counter);
                  observer.unobserve(counter);
                }
              });
            }, { threshold: 0.3 });

            counters.forEach(function (counter) {
              observer.observe(counter);
            });
          } else {
            counters.forEach(function (counter) {
              animateCounter(counter);
            });
          }

          // ==========================
          // calculateArrowPosition INIT
          // ==========================
          calculateArrowPosition();
          window.addEventListener('resize', calculateArrowPosition);
        });


        // SHARE BUTTON
        (function() {
          function doShare(btn) {
            if (navigator.share) {
              navigator.share({ title: document.title, url: window.location.href });
            } else if (navigator.clipboard) {
              navigator.clipboard.writeText(window.location.href).then(function() {
                var orig = btn.innerHTML;
                btn.innerHTML = '<i class="bi bi-check-lg"></i>';
                setTimeout(function() { btn.innerHTML = orig; }, 2000);
              });
            }
          }
          var shareBtn = document.getElementById('xipShareBtn');
          if (shareBtn) shareBtn.addEventListener('click', function() { doShare(this); });
          var shareBtnMobile = document.getElementById('xipShareBtnMobile');
          if (shareBtnMobile) shareBtnMobile.addEventListener('click', function() { doShare(this); });
        })();

        // SCROLL TO TOP FUNCTIONALITY (combined, shows a bit earlier)
        (function() {
          const scrollToTopBtn = document.getElementById('scrollToTop');
          if (!scrollToTopBtn) return;

          const showButtonAfter = window.innerHeight * 0.6; // earlier than 1 full scroll

          function throttle(func, wait) {
            let timeout;
            return function executedFunction(...args) {
              const later = () => {
                clearTimeout(timeout);
                func(...args);
              };
              clearTimeout(timeout);
              timeout = setTimeout(later, wait);
            };
          }

          function checkScrollPosition() {
            const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
            if (scrollTop > showButtonAfter) {
              scrollToTopBtn.classList.add('show');
            } else {
              scrollToTopBtn.classList.remove('show');
            }
          }

          function scrollToTop(e) {
            e.preventDefault();
            window.scrollTo({
              top: 0,
              behavior: 'smooth'
            });
          }

          window.addEventListener('scroll', throttle(checkScrollPosition, 100));
          scrollToTopBtn.addEventListener('click', scrollToTop);
          checkScrollPosition();
        })();

        // ===========================
        // GLOBAL VARIABLES
        // ===========================
        const overlay = document.getElementById('mobileOverlay');
        const panels = document.querySelectorAll('.menu-panel');
        const panelStack = [];
        const contactPanel = document.getElementById('contactPanel');
        let savedScrollPosition = 0;

        // ===========================
        // DESKTOP MENU - ARROW POSITIONING
        // ===========================
        document.addEventListener('DOMContentLoaded', function() {
          calculateArrowPosition();
          initializeObservers();
        });

        window.addEventListener('resize', function() {
          calculateArrowPosition();
          // Close mobile menu if window is resized to desktop
          if (window.innerWidth >= 992) {
            if (overlay && overlay.classList.contains('active')) {
              closeMobileMenu();
            }
          }
        });

        function calculateArrowPosition() {
          const kioskMenuItem = document.getElementById('kiosk-menu-item');
          if (!kioskMenuItem || window.innerWidth < 992) return;

          const navLink = kioskMenuItem.querySelector('.nav-link');
          const megaMenu = kioskMenuItem.querySelector('.megamenu');
          const navContainer = kioskMenuItem.closest('.container');

          if (!navLink || !megaMenu || !navContainer) return;

          const linkRect = navLink.getBoundingClientRect();
          const linkCenterAbsolute = linkRect.left + (linkRect.width / 2);
          const arrowPositionInMenu = linkCenterAbsolute - (megaMenu.getBoundingClientRect().left + 15);

          megaMenu.style.setProperty('--arrow-left', `${arrowPositionInMenu}px`);
        }

        // Recalculate on hover for dynamic positioning
        const kioskMenuItem = document.getElementById('kiosk-menu-item');
        if (kioskMenuItem) {
          kioskMenuItem.addEventListener('mouseenter', calculateArrowPosition);
        }

        // Calculate arrow position for EHS menu
        const ehsMenuItem = document.getElementById('ehs-menu-item');
        if (ehsMenuItem) {
          ehsMenuItem.addEventListener('mouseenter', function() {
            if (window.innerWidth < 992) return;
            const navLink = ehsMenuItem.querySelector('.nav-link');
            const megaMenu = ehsMenuItem.querySelector('.megamenu');
            if (!navLink || !megaMenu) return;

            const linkRect = navLink.getBoundingClientRect();
            const linkCenterAbsolute = linkRect.left + (linkRect.width / 2);
            const arrowPositionInMenu = linkCenterAbsolute - (megaMenu.getBoundingClientRect().left + 15);
            megaMenu.style.setProperty('--arrow-left', `${arrowPositionInMenu}px`);
          });
        }

        // Calculate arrow position for TEC Solutions menu
        const tecMenuItem = document.getElementById('tec-solutions-menu-item');
        if (tecMenuItem) {
          tecMenuItem.addEventListener('mouseenter', function() {
            if (window.innerWidth < 992) return;
            const navLink = tecMenuItem.querySelector('.nav-link');
            const megaMenu = tecMenuItem.querySelector('.megamenu');
            if (!navLink || !megaMenu) return;

            const linkRect = navLink.getBoundingClientRect();
            const linkCenterAbsolute = linkRect.left + (linkRect.width / 2);
            const arrowPositionInMenu = linkCenterAbsolute - (megaMenu.getBoundingClientRect().left + 15);
            megaMenu.style.setProperty('--arrow-left', `${arrowPositionInMenu}px`);
          });
        }

        // ===========================
        // MOBILE MENU FUNCTIONS
        // ===========================
        function openMobileMenu() {
          if (!overlay) return;
          overlay.classList.add('active');
          panelStack.length = 0;
          showOnly('panel-main');
          document.body.classList.add('body-no-scroll');
          document.body.classList.add('mobile-menu-open');

          // Hide search box on open
          const mainPanel = document.getElementById('panel-main');
          if (mainPanel) {
            const mainSearchBox = mainPanel.querySelector('.mobile-search-box, .search-input-wrapper');
            if (mainSearchBox) mainSearchBox.style.display = 'none';
          }
        }

        function closeMobileMenu() {
          if (!overlay) return;
          overlay.classList.remove('active');
          panelStack.length = 0;
          document.body.classList.remove('body-no-scroll');
          document.body.classList.remove('mobile-menu-open');

          // Reset all panels to main after animation
          setTimeout(() => {
            showOnly('panel-main');
          }, 300);
        }

        function showPanel(panelName) {
          const current = document.querySelector('.menu-panel.active');
          if (current) panelStack.push(current.id);
          showOnly(`panel-${panelName}`);
        }

        function goBack() {
          const prev = panelStack.pop();
          if (prev) {
            showOnly(prev);
          } else {
            showOnly('panel-main');
          }
        }

        function showOnly(id) {
          if (!panels || panels.length === 0) return;

          panels.forEach(p => p.classList.remove('active'));
          const panel = document.getElementById(id);

          if (panel) {
            panel.classList.add('active');

            // Hide search wrapper when switching panels
            const searchWrapper = panel.querySelector('.search-input-wrapper, .mobile-search-box');
            if (searchWrapper) {
              searchWrapper.style.display = 'none';
            }

            // Scroll to top of new panel
            panel.scrollTop = 0;
          }
        }

        function toggleSearchInPanel(btn) {
          const panel = btn.closest('.menu-panel');
          if (!panel) return;

          const searchWrapper = panel.querySelector('.search-input-wrapper, .mobile-search-box');
          if (searchWrapper) {
            const isHidden = searchWrapper.style.display === 'none' || searchWrapper.style.display === '';
            searchWrapper.style.display = isHidden ? 'block' : 'none';

            if (isHidden) {
              const searchInput = panel.querySelector('input[type="text"]');
              if (searchInput) {
                setTimeout(() => searchInput.focus(), 100);
              }
            }
          }
        }

        // ===========================
        // MOBILE TAB SWITCHING (TEC SOLUTIONS)
        // ===========================
        function switchMobileTab(tabName) {
          // Remove active class from all tab buttons
          const tabButtons = document.querySelectorAll('.mobile-tab-btn');
          tabButtons.forEach(btn => btn.classList.remove('active'));

          // Remove active class from all tab contents
          const tabContents = document.querySelectorAll('.mobile-tab-content');
          tabContents.forEach(content => content.classList.remove('active'));

          // Find and activate clicked button
          const clickedButton = event.target;
          if (clickedButton) {
            clickedButton.classList.add('active');
          }

          // Show corresponding content
          const targetContent = document.getElementById(`mobile-${tabName}-tab`);
          if (targetContent) {
            targetContent.classList.add('active');
          }
        }     

        // ===========================
        // SCROLL ANIMATIONS - FADE UP
        // ===========================
        function initializeObservers() {
          const fadeElements = document.querySelectorAll('.fade-up-item');
          if (fadeElements.length === 0) return;

          const handleIntersection = (entries, observer) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                // Add the class to start the CSS animation
                entry.target.classList.add('is-visible');
                // Stop observing it once it has animated
                observer.unobserve(entry.target);
              }
            });
          };

          const observerOptions = {
            root: null, // Viewport is the root
            rootMargin: '0px',
            threshold: 0.1 // Triggers when 10% of the element is visible
          };

          const observer = new IntersectionObserver(handleIntersection, observerOptions);
          fadeElements.forEach(element => {
            observer.observe(element);
          });
        }

        // ===========================
        // NAVBAR SCROLL EFFECT
        // ===========================
        let lastScroll = 0;
        const navbar = document.querySelector('.navbar-glass');

        window.addEventListener('scroll', function() {
          const currentScroll = window.pageYOffset;

          if (navbar) {
            if (currentScroll > 50) {
              navbar.classList.add('scrolled');
            } else {
              navbar.classList.remove('scrolled');
            }
          }

          lastScroll = currentScroll;
        });

        // ===========================
        // SEARCH FUNCTIONALITY (OPTIONAL)
        // ===========================
        function setupSearchFilters() {
          // Main menu search
          const mainSearchInput = document.getElementById('mainMenuSearchInput');
          if (mainSearchInput) {
            mainSearchInput.addEventListener('input', function(e) {
              filterMenuItems(e.target.value, 'panel-main');
            });
          }

          // Kiosk search
          const kioskSearchInput = document.getElementById('kioskSearchInput');
          if (kioskSearchInput) {
            kioskSearchInput.addEventListener('input', function(e) {
              filterGridItems(e.target.value, 'kioskSubmenuGrid');
            });
          }

          // EHS search
          const ehsSearchInput = document.getElementById('ehsSearchInput');
          if (ehsSearchInput) {
            ehsSearchInput.addEventListener('input', function(e) {
              filterCardItems(e.target.value, 'panel-ehs');
            });
          }

          // TEC Solutions search
          const tecSearchInput = document.getElementById('tecSearchInput');
          if (tecSearchInput) {
            tecSearchInput.addEventListener('input', function(e) {
              filterMenuItems(e.target.value, 'panel-tec-solutions');
            });
          }

          // About search
          const aboutSearchInput = document.getElementById('aboutSearchInput');
          if (aboutSearchInput) {
            aboutSearchInput.addEventListener('input', function(e) {
              filterMenuItems(e.target.value, 'panel-about');
            });
          }
        }

        function filterMenuItems(searchTerm, panelId) {
          const panel = document.getElementById(panelId);
          if (!panel) return;

          const items = panel.querySelectorAll('.menu-list button, .submenu-list a, .submenu-list button');
          searchTerm = searchTerm.toLowerCase();

          items.forEach(item => {
            const text = item.textContent.toLowerCase();
            if (text.includes(searchTerm)) {
              item.style.display = '';
            } else {
              item.style.display = 'none';
            }
          });
        }

        function filterGridItems(searchTerm, gridId) {
          const grid = document.getElementById(gridId);
          if (!grid) return;

          const items = grid.querySelectorAll('.grid-card');
          searchTerm = searchTerm.toLowerCase();

          items.forEach(item => {
            const text = item.textContent.toLowerCase();
            if (text.includes(searchTerm)) {
              item.style.display = '';
            } else {
              item.style.display = 'none';
            }
          });
        }

        function filterCardItems(searchTerm, panelId) {
          const panel = document.getElementById(panelId);
          if (!panel) return;

          const items = panel.querySelectorAll('.mobile-ehs-card, .mobile-discover-card');
          searchTerm = searchTerm.toLowerCase();

          items.forEach(item => {
            const text = item.textContent.toLowerCase();
            if (text.includes(searchTerm)) {
              item.style.display = '';
            } else {
              item.style.display = 'none';
            }
          });
        }

        // Initialize search filters after DOM is loaded
        document.addEventListener('DOMContentLoaded', function() {
          setupSearchFilters();
        });

        // ===========================
        // ESCAPE KEY TO CLOSE MENUS
        // ===========================
        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape') {
            // Close mobile menu if open
            if (overlay && overlay.classList.contains('active')) {
              closeMobileMenu();
            }
            // Close contact panel if open
            if (contactPanel && contactPanel.classList.contains('active')) {
              closeContactPanel();
            }
          }
        });

        // ===========================
        // PREVENT SCROLL ON MOBILE MENU
        // ===========================
        if (overlay) {
          overlay.addEventListener('touchmove', function(e) {
            // Allow scrolling within panels but prevent body scroll
            if (e.target === overlay) {
              e.preventDefault();
            }
          }, { passive: false });
        }

        // ===========================
        // SMOOTH SCROLL FOR ANCHOR LINKS
        // ===========================
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
          anchor.addEventListener('click', function(e) {
            const href = this.getAttribute('href');
            if (href === '#' || href === 'javascript:void(0);') return;

            e.preventDefault();
            const target = document.querySelector(href);

            if (target) {
              // Close mobile menu if open
              if (overlay && overlay.classList.contains('active')) {
                closeMobileMenu();
              }

              // Smooth scroll to target
              setTimeout(() => {
                target.scrollIntoView({
                  behavior: 'smooth',
                  block: 'start'
                });
              }, 300);
            }
          });
        });

        // ===========================
        // LAZY LOADING IMAGES (OPTIONAL)
        // ===========================
        function initLazyLoading() {
          const lazyImages = document.querySelectorAll('img[loading="lazy"]');

          if ('IntersectionObserver' in window) {
            const imageObserver = new IntersectionObserver((entries, observer) => {
              entries.forEach(entry => {
                if (entry.isIntersecting) {
                  const img = entry.target;
                  if (img.dataset.src) {
                    img.src = img.dataset.src;
                    img.removeAttribute('data-src');
                  }
                  imageObserver.unobserve(img);
                }
              });
            });

            lazyImages.forEach(img => imageObserver.observe(img));
          } else {
            // Fallback for browsers that don't support IntersectionObserver
            lazyImages.forEach(img => {
              if (img.dataset.src) {
                img.src = img.dataset.src;
              }
            });
          }
        }

        // Initialize lazy loading
        document.addEventListener('DOMContentLoaded', function() {
          initLazyLoading();
        });

        // ===========================
        // CAROUSEL AUTO-ADJUST HEIGHT (IF USING OWL CAROUSEL)
        // ===========================
        if (typeof jQuery !== 'undefined' && jQuery.fn.owlCarousel) {
          jQuery(document).ready(function($) {
            // Initialize carousels with equal heights
            $('.owl-carousel').each(function() {
              $(this).on('initialized.owl.carousel', function() {
                equalizeCarouselHeights($(this));
              });

              $(this).on('resized.owl.carousel', function() {
                equalizeCarouselHeights($(this));
              });
            });
          });

          function equalizeCarouselHeights($carousel) {
            let maxHeight = 0;
            $carousel.find('.owl-item.active').each(function() {
              const height = $(this).height();
              if (height > maxHeight) maxHeight = height;
            });
            $carousel.find('.owl-item').height(maxHeight);
          }
        }

        // ===========================
        // UTILITY: DEBOUNCE FUNCTION
        // ===========================
        function debounce(func, wait) {
          let timeout;
          return function executedFunction(...args) {
            const later = () => {
              clearTimeout(timeout);
              func(...args);
            };
            clearTimeout(timeout);
            timeout = setTimeout(later, wait);
          };
        }

        // Debounced resize handler
        const debouncedResize = debounce(function() {
          calculateArrowPosition();
        }, 250);

        window.addEventListener('resize', debouncedResize);

        // ===========================
        // CONSOLE LOG FOR DEBUGGING (REMOVE IN PRODUCTION)
        // ===========================
        console.log('A"? XIPHIAS Navigation System Initialized');
        console.log('A,?oA Mobile Menu Ready');
        console.log('A,?"AA_A,A? Desktop Megamenu Ready');
        console.log('A,A" Animations Loaded');


        document.addEventListener("DOMContentLoaded", function () {

            const input = document.getElementById("kioskSearchInput");
            const clearBtn = document.querySelector(".search-clear-btn");

            input.addEventListener("input", function () {

                const searchValue = this.value.toLowerCase().trim();

                // Show / Hide clear button
                clearBtn.style.display = searchValue ? "block" : "none";

                // Filter Main Products
                document.querySelectorAll(".menu-product-item").forEach(function (item) {

                    const title = item.getAttribute("data-title");

                    if (!searchValue || title.includes(searchValue)) {
                        item.closest(".col").style.display = "block";
                    } else {
                        item.closest(".col").style.display = "none";
                    }

                });

                // Filter New Products
                document.querySelectorAll(".mobile-discover-card-grid").forEach(function (item) {

                    const title = item.getAttribute("data-title");

                    if (!searchValue || title.includes(searchValue)) {
                        item.style.display = "flex";
                    } else {
                        item.style.display = "none";
                    }

                });

            });

        });

        function clearSearch(btn) {
            const input = document.getElementById("kioskSearchInput");
            input.value = "";
            input.dispatchEvent(new Event("input"));
        }

        document.addEventListener("DOMContentLoaded", function () {

            const input = document.getElementById("ehsSearchInput");
            if (!input) return;

            const panel = document.getElementById("panel-ehs");
            const clearBtn = panel.querySelector(".search-clear-btn");
            const featuredSection = panel.querySelector(".mobile-featured-section");

            input.addEventListener("input", function () {

                const searchValue = this.value.toLowerCase().trim();
                clearBtn.style.display = searchValue ? "block" : "none";

                let visibleCount = 0;

                panel.querySelectorAll(".mobile-ehs-card").forEach(function (card) {

                    const title = card.getAttribute("data-title");

                    if (!searchValue || title.includes(searchValue)) {
                        card.style.display = "block";
                        visibleCount++;
                    } else {
                        card.style.display = "none";
                    }

                });

                // Hide featured section while searching
                featuredSection.style.display = searchValue ? "none" : "block";

                // Optional: Show "No results"
                let noResult = panel.querySelector(".no-results-msg");

                if (visibleCount === 0 && searchValue) {
                    if (!noResult) {
                        noResult = document.createElement("div");
                        noResult.className = "no-results-msg text-center py-3";
                        noResult.innerText = "No EHS modules found.";
                        panel.appendChild(noResult);
                    }
                } else {
                    if (noResult) noResult.remove();
                }

            });

        });

        function clearSearch(btn) {
            const input = btn.closest(".mobile-search-box").querySelector("input");
            input.value = "";
            input.dispatchEvent(new Event("input"));
        }

               $(window).on('load', function () {
            if ($.fn.owlCarousel) {
                $('.top-client-owl-carousel').owlCarousel({
                    loop: true,
                    autoplay: true,
                    autoplayTimeout: 2000,
                    smartSpeed: 800,
                    // +? removed animateOut and animateIn
                    nav: false,
                    dots: false,
                    margin: 0,
                    items: 1
                });
            } else {
                console.error('Owl Carousel not loaded!');
            }
        });

        /* Equalize the home "about" bento cards (Strategy/Quality and
           Trust That Speaks / Recognition That Speaks) to matching heights.
           Done in JS AFTER the carousels initialize so it never constrains the
           Owl carousel layout (a CSS height:100% squashed the client carousel).
           Pairs cards in rows of two; resets to natural height on mobile/resize. */

function equalizeBentoCards() {
    var wrap = document.querySelector('.single-about-wrapper');
    if (!wrap) return;
    var allCards = wrap.querySelectorAll('.single-about');
    var i;
    // Reset ALL cards first
    for (i = 0; i < allCards.length; i++) {
        allCards[i].style.height = '';
    }
    if (window.innerWidth < 768) { return; }
    // Only equalize cards WITHOUT .no-equalize class
    var cards = Array.from(wrap.querySelectorAll('.single-about:not(.no-equalize)'));
    // PASS 1 ?" batch ALL geometry reads first (forces a single reflow, not one per pair)
    var heights = [];
    for (i = 0; i < cards.length; i += 2) {
        var a = cards[i], b = cards[i + 1];
        if (!b) { break; }
        heights[i] = Math.max(a.offsetHeight, b.offsetHeight);
    }
    // PASS 2 ?" batch ALL writes (no interleaved reads, so no repeated forced reflow)
    for (i = 0; i < cards.length; i += 2) {
        var a2 = cards[i], b2 = cards[i + 1];
        if (!b2) { break; }
        a2.style.height = heights[i] + 'px';
        b2.style.height = heights[i] + 'px';
    }
}

        $(window).on('load', function () { setTimeout(equalizeBentoCards, 200); });
        $(window).on('resize', function () { setTimeout(equalizeBentoCards, 200); });

