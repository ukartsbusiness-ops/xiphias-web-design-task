// ========== ACCORDION: ensure only one open at a time ==========
document.addEventListener('DOMContentLoaded', function () {
    const accordionButtons = document.querySelectorAll('.accordion-button');

    accordionButtons.forEach(button => {
        button.addEventListener('click', function () {
            const targetId = this.getAttribute('data-bs-target') || this.getAttribute('aria-controls');
            const target = document.getElementById(targetId.replace('#', ''));
            if (!target) return;

            const isOpen = target.classList.contains('show');

            const accordion = target.closest('.accordion');
            if (accordion) {
                accordion.querySelectorAll('.accordion-collapse').forEach(collapse => {
                    collapse.classList.remove('show');
                });

                accordion.querySelectorAll('.accordion-button').forEach(btn => {
                    btn.classList.add('collapsed');
                    btn.setAttribute('aria-expanded', 'false');
                });
            }

            if (!isOpen) {
                target.classList.add('show');
                this.classList.remove('collapsed');
                this.setAttribute('aria-expanded', 'true');
            }
        });
    });
});

// ========== DATE FORMATTER ==========
function formatDateTime(dateString) {
    if (!dateString) return '';

    const date = new Date(dateString);
    if (isNaN(date.getTime())) return dateString;

    const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun',
        'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

    const day = String(date.getDate()).padStart(2, '0');
    const month = monthNames[date.getMonth()];
    const year = date.getFullYear();

    const hours = String(date.getHours()).padStart(2, '0');
    const minutes = String(date.getMinutes()).padStart(2, '0');

    return `${day} ${month} ${year} ${hours}:${minutes}`;
}

// ========== ESCAPE HTML ==========
function escapeHtml(text) {
    if (!text) return '';
    var map = {
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;'
    };
    return text.replace(/[&<>"']/g, function (m) { return map[m]; });
}

// ========== IMAGE GALLERY SWITCHER ==========
function changeMainImage(thumbnail, imagePath) {
    const mainImage = document.getElementById('mainImage');
    if (!mainImage) return;

    const allThumbnails = document.querySelectorAll('.sub-image');
    allThumbnails.forEach(img => img.classList.remove('active'));

    thumbnail.classList.add('active');

    mainImage.style.opacity = '0';

    setTimeout(() => {
        mainImage.src = imagePath;
        mainImage.style.opacity = '1';
    }, 200);
}

document.addEventListener('DOMContentLoaded', function () {
    const thumbnails = document.querySelectorAll('.sub-image');

    thumbnails.forEach(thumbnail => {
        thumbnail.addEventListener('mouseenter', function () {
            const imagePath = this.src || this.getAttribute('data-image');
            changeMainImage(this, imagePath);
        });

        thumbnail.addEventListener('click', function () {
            const imagePath = this.src || this.getAttribute('data-image');
            changeMainImage(this, imagePath);
        });
    });
});

// ========== ENVIRONMENTAL SAFETY PAGE MODULE ==========
(function () {
    'use strict';

    document.addEventListener('DOMContentLoaded', function () {
        ehsInitScrollAnimations();
        ehsInitLazyLoading();
        ehsInitSmoothScroll();
        ehsInitCounterAnimations();
        ehsInitParallax();
    });

    function ehsInitScrollAnimations() {
        const ehsFadeElements = document.querySelectorAll('.ehs-fade-in');
        if (!ehsFadeElements.length) return;

        const ehsObserverOptions = {
            root: null,
            rootMargin: '0px',
            threshold: 0.1
        };

        const ehsObserver = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                    entry.target.classList.add('ehs-visible');
                }
            });
        }, ehsObserverOptions);

        ehsFadeElements.forEach(function (element) {
            ehsObserver.observe(element);
        });
    }

    function ehsInitLazyLoading() {
        const ehsLazyImages = document.querySelectorAll('.ehs-lazy-load');
        if (!ehsLazyImages.length) return;

        const ehsImageObserverOptions = {
            root: null,
            rootMargin: '50px',
            threshold: 0
        };

        const ehsImageObserver = new IntersectionObserver(function (entries, observer) {
            entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                    const img = entry.target;

                    if (img.dataset.src) {
                        img.src = img.dataset.src;
                    }

                    img.classList.add('ehs-loaded');
                    observer.unobserve(img);
                }
            });
        }, ehsImageObserverOptions);

        ehsLazyImages.forEach(function (img) {
            ehsImageObserver.observe(img);
        });
    }

    function ehsInitSmoothScroll() {
        const ehsAnchorLinks = document.querySelectorAll('a[href^="#"]');

        ehsAnchorLinks.forEach(function (link) {
            link.addEventListener('click', function (e) {
                const href = this.getAttribute('href');

                if (href === '#') {
                    e.preventDefault();
                    return;
                }

                const targetId = href.substring(1);
                const targetElement = document.getElementById(targetId);

                if (targetElement) {
                    e.preventDefault();

                    const headerOffset = 80;
                    const elementPosition = targetElement.getBoundingClientRect().top;
                    const offsetPosition = elementPosition + window.pageYOffset - headerOffset;

                    window.scrollTo({
                        top: offsetPosition,
                        behavior: 'smooth'
                    });
                }
            });
        });
    }

    function ehsInitCounterAnimations() {
        const ehsCounters = document.querySelectorAll('.ehs-stat-number, .ehs-roi-number, .ehs-stats-number');
        if (!ehsCounters.length) return;

        const ehsCounterObserverOptions = {
            root: null,
            rootMargin: '0px',
            threshold: 0.5
        };

        const ehsCounterObserver = new IntersectionObserver(function (entries, observer) {
            entries.forEach(function (entry) {
                if (entry.isIntersecting && !entry.target.classList.contains('ehs-counted')) {
                    entry.target.classList.add('ehs-counted');
                    ehsAnimateCounter(entry.target);
                    observer.unobserve(entry.target);
                }
            });
        }, ehsCounterObserverOptions);

        ehsCounters.forEach(function (counter) {
            ehsCounterObserver.observe(counter);
        });
    }

    function ehsAnimateCounter(element) {
        const text = element.textContent;
        const hasPercent = text.includes('%');
        const hasPlus = text.includes('+');
        const hasRange = text.includes('-');

        let numericValue = parseFloat(text.replace(/[^0-9.-]/g, ''));
        if (isNaN(numericValue)) return;

        const duration = 2000;
        const steps = 60;
        const stepValue = numericValue / steps;
        const stepDuration = duration / steps;
        let currentStep = 0;

        element.textContent = '0' + (hasPercent ? '%' : '') + (hasPlus ? '+' : '');

        const timer = setInterval(function () {
            currentStep++;
            const currentValue = Math.min(stepValue * currentStep, numericValue);

            let displayValue;
            if (Number.isInteger(numericValue)) {
                displayValue = Math.round(currentValue);
            } else {
                displayValue = currentValue.toFixed(1);
            }

            if (hasRange) {
                element.textContent = text;
                clearInterval(timer);
            } else {
                element.textContent = displayValue + (hasPercent ? '%' : '') + (hasPlus ? '+' : '');
            }

            if (currentStep >= steps) {
                clearInterval(timer);
                element.textContent = text;
            }
        }, stepDuration);
    }

    function ehsInitParallax() {
        window.addEventListener('scroll', function () {
            const scrolled = window.pageYOffset;
            const heroSection = document.querySelector('.ehs-hero-section');

            if (heroSection && scrolled < window.innerHeight) {
                const bgPattern = heroSection.querySelector('.ehs-hero-bg-pattern');
                if (bgPattern) {
                    bgPattern.style.transform = 'translateY(' + scrolled * 0.5 + 'px)';
                }
            }
        });
    }

    const ehsContactForm = document.querySelector('.ehs-contact-form');
    if (ehsContactForm) {
        ehsContactForm.addEventListener('submit', function (e) {
            e.preventDefault();

            const inputs = this.querySelectorAll('.ehs-form-control');
            let isValid = true;

            inputs.forEach(function (input) {
                if (input.hasAttribute('required') && !input.value.trim()) {
                    isValid = false;
                    input.style.borderColor = '#dc3545';
                } else {
                    input.style.borderColor = '';
                }
            });

            if (isValid) {
                console.log('Form submitted successfully!');
                alert('Thank you for your inquiry! Our team will contact you shortly.');
                this.reset();
            } else {
                alert('Please fill in all required fields.');
            }
        });
    }

    document.addEventListener('click', function (e) {
        const btn = e.target.closest('.enquire-btn');
        if (!btn) return;

        e.preventDefault();

        const panel = document.getElementById('global-contact-panel');
        if (!panel) return;

        const title = btn.dataset.panelTitle;
        if (title) {
            const titleEl = panel.querySelector('.panel-title');
            if (titleEl) titleEl.innerText = title;
        }

        panel.classList.add('active');
        document.body.classList.add('body-no-scroll');
    });

})();

// ========== TABS (Why PMS / Kiosk) ==========
function openCity(evt, cityName) {
    var i, tabcontent, tablinks;
    tabcontent = document.getElementsByClassName("city");
    for (i = 0; i < tabcontent.length; i++) {
        tabcontent[i].style.display = "none";
    }

    tablinks = document.getElementsByClassName("tablink");
    for (i = 0; i < tablinks.length; i++) {
        tablinks[i].className = tablinks[i].className.replace(" w3-red", "");
    }

    document.getElementById(cityName).style.display = "block";
    evt.currentTarget.className += " w3-red";
}

document.addEventListener("DOMContentLoaded", function () {
    var pms = document.getElementById("pms");
    if (pms) {
        pms.style.display = "block";
    }
});


document.addEventListener('click', function (e) {

    const btn = e.target.closest('.static-enquire-btn');
    if (btn) {
        console.log("STATIC BUTTON CLICKED");
    }
    if (!btn) return;

    e.preventDefault();
    

    const panel = document.getElementById('global-contact-panel');
    if (!panel) {
        console.log("Panel not found");
        return;
    }

    const title = btn.dataset.panelTitle;   // ✅ FIXED
    console.log("Title:", title);

    if (!title) return;

    // Update panel title
    const titleEl = panel.querySelector('.panel-title');
    if (titleEl) titleEl.innerText = title;

    // Update iframe
    const iframe = panel.querySelector('.GlobalHandlerIframe');
    if (iframe) {

        const baseUrl = "https://handlerxip.xiphiastec.com/UniversalHandler/enquiryform";

        const params = new URLSearchParams({
            product: title.replace(/'/g, "") + " Inquiry",
            OtpInterface: "BOTH",
            Company: "XIPHIAS"
        });

        iframe.src = baseUrl + "?" + params.toString();
        console.log("Iframe Final src:", iframe.src);
    }

    panel.classList.add('active');
    document.body.classList.add('body-no-scroll');
});

// ========== BROCHURE DOWNLOAD: gated on successful enquiry-form submit ==========
// A visitor may download a brochure only AFTER filling the enquiry form and
// passing OTP verification (the form is the handlerxip.xiphiastec.com iframe).
// "Verify once, unlock all": after one successful verification in this visit,
// further brochure clicks download immediately without re-prompting.
//
// Gate a link by giving it:  class="... brochure-gated-btn"  href="#"
//   data-brochure-url="<pdf url>"  data-brochure-name="<save-as name>"
//   data-panel-title="<panel heading / lead tag>"
(function () {
    const UNLOCK_KEY = 'xkBrochureUnlocked';   // sessionStorage = per tab = per visit
    let pendingBrochure = null;

    function isUnlocked() {
        try { return sessionStorage.getItem(UNLOCK_KEY) === 'true'; } catch (e) { return false; }
    }
    function setUnlocked() {
        try { sessionStorage.setItem(UNLOCK_KEY, 'true'); } catch (e) { /* private mode: ignore */ }
    }

    function triggerDownload(url, name) {
        const link = document.createElement('a');
        link.href = url;
        link.download = name || '';
        link.target = '_blank';            // fallback: browsers ignore download attr cross-origin
        link.rel = 'noopener';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }

    function showSuccessBanner(url, name) {
        const panel = document.getElementById('global-contact-panel');
        if (!panel) return;
        if (panel.querySelector('.xk-brochure-success')) return;
        const bar = document.createElement('div');
        bar.className = 'xk-brochure-success';
        bar.innerHTML =
            '<div style="display:flex;flex-direction:column;align-items:center;gap:.75rem;padding:1.25rem 1rem;background:#f0fdf4;border-top:2px solid #22c55e;text-align:center;">'
            + '<a href="' + url + '" target="_blank" rel="noopener" download="' + name + '" style="display:inline-flex;align-items:center;gap:.4rem;padding:.6rem 1.25rem;background:#16a34a;color:#fff;border-radius:6px;font-weight:600;font-size:.85rem;text-decoration:none;"><i class="bi bi-download"></i>Download Brochure</a>'
            + '</div>';
        const body = panel.querySelector('.panel-body');
        if (body) body.after(bar);
    }

    document.addEventListener('click', function (e) {
        const btn = e.target.closest('.brochure-gated-btn');
        if (!btn) return;

        e.preventDefault();

        const url = btn.dataset.brochureUrl;
        if (!url) return;
        const name = btn.dataset.brochureName || '';
        const title = btn.dataset.panelTitle || 'Brochure';

        // Verify once, unlock all: already verified this visit → download immediately.
        if (isUnlocked()) {
            triggerDownload(url, name);
            return;
        }

        pendingBrochure = { url: url, name: name };

        const panel = document.getElementById('global-contact-panel');
        if (!panel) { triggerDownload(url, name); return; }   // no panel on page → fail open

        // Clear any stale success banner from a previous download
        const oldBanner = panel.querySelector('.xk-brochure-success');
        if (oldBanner) oldBanner.remove();

        // Set panel title
        const titleEl = panel.querySelector('.panel-title');
        if (titleEl) titleEl.innerText = title;

        // Rebuild the iframe so the CRM lead is tagged as a brochure request
        const iframe = panel.querySelector('.GlobalHandlerIframe');
        if (iframe) {
            const params = new URLSearchParams({
                product: title.replace(/'/g, "") + " - Brochure Download",
                OtpInterface: "BOTH",
                Company: "XIPHIAS"
            });
            iframe.src = "https://handlerxip.xiphiastec.com/UniversalHandler/enquiryform?" + params.toString();
        }

        panel.classList.add('active');
        document.body.classList.add('body-no-scroll');
    });

    window.addEventListener('message', function (event) {
        // Only trust messages from the enquiry-form handler domain
        if (typeof event.origin !== 'string' || event.origin.indexOf('xiphiastec.com') === -1) return;

        const data = event.data;
        const isSuccess =
            (data && typeof data === 'object' && data.type === 'ENQUIRY_SUBMITTED') ||   // real signal
            data === 'form-submitted' ||                                                  // legacy fallbacks
            data === 'success' ||
            (data && typeof data === 'object' && (data.status === 'success' || data.success === true));

        if (!isSuccess) return;

        // Any verified submit unlocks brochures for the rest of the visit.
        setUnlocked();

        if (!pendingBrochure) return;   // verified via a non-brochure form → nothing queued

        triggerDownload(pendingBrochure.url, pendingBrochure.name);
        showSuccessBanner(pendingBrochure.url, pendingBrochure.name);
        pendingBrochure = null;
        // Panel stays open so the visitor sees the confirmation + manual download link.
    });
})();
